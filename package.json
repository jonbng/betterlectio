{
  "name": "betterlectio",
  "description": "Better styling and improved functionality for Lectio",
  "private": true,
  "version": "0.0.36",
  "author": "Jonathan Bangert",
  "homepage": "https://github.com/jonbng/betterlectio",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonbng/betterlectio.git"
  },
  "bugs": {
    "url": "https://github.com/jonbng/betterlectio/issues"
  },
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "dev:safari": "wxt -b safari --mv3",
    "geocode:schools": "bun run ./tools/geocode-schools.mjs",
    "import:schools": "bun run ./tools/import-schools-to-supabase.mjs",
    "cleanup:legacy-profile-pictures": "bun run ./tools/cleanup-legacy-profile-pictures.mjs",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:safari": "wxt zip -b safari --mv3",
    "compile": "tsc --noEmit",
    "test:navigation": "bun run ./tools/test-lectio-navigation.mjs",
    "postinstall": "wxt prepare",
    "lectio": "bun run ./tools/lectio-cli/src/index.ts"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^25.9.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "linkedom": "^0.18.12",
    "playwright": "^1.61.1",
    "postcss": "^8.5.17",
    "satori": "^0.26.0",
    "shadcn": "^3.8.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "wxt": "^0.20.27"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hiseb/confetti": "^2.1.0",
    "@preact/compat": "^18.3.2",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-collapsible": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-separator": "^1.1.10",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-toggle": "^1.1.12",
    "@radix-ui/react-toggle-group": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@supabase/supabase-js": "^2.110.2",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jsqr": "^1.4.0",
    "lucide-preact": "^0.577.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "posthog-node": "^5.41.0",
    "preact": "^10.29.7",
    "qrcode": "^1.5.4",
    "recharts": "2.15.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  }
}
